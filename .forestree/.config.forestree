      "id": "pet-shop-simulator-game-client",
      "name": "Pet Shop Simulator (Game Client)",
      "type": "frontend"
    },
    {
      "canvas": {
        "widgets": [
          {
            "data": {
              "text": "Editor-time / headless tooling (Assets/Editor, driven by root build.sh) that sets up the project (TextMesh Pro essentials, Always-Included Shaders), generates the scene (SceneBuilder, GameBuilder), imports/reports on Kenney and Asset Store art, verifies spawns/materials/shaders, and produces the Linux player build plus smoke-test screenshots. Runs only at build/dev time - never shipped in the game itself."
            },
            "h": 180,
            "id": "widget-1790266201043-0",
            "title": "Intent & Scope Description",
            "type": "text",
            "w": 350,
            "x": 30,
            "y": 30
          },
          {
            "data": {
              "techs": [
                "Unity Editor scripting (UnityEditor)",
                "Bash (build.sh)",
                "Headless Linux batchmode build"
              ]
            },
            "h": 200,
            "id": "widget-1790266219556-1",
            "title": "Tech Stack Profiles",
            "type": "techstack",
            "w": 350,
            "x": 60,
            "y": 60
          },
          {
            "data": {
              "items": [
                {
                  "done": false,
                  "text": "ProjectSetup / ShaderInclusion: TextMesh Pro essentials + Always Included Shaders (required before first Play)"
                },
                {
                  "done": false,
                  "text": "SceneBuilder / GameBuilder: generate MainScene.unity and produce the Linux player build"
                },
                {
                  "done": false,
                  "text": "AssetStoreImporter / KenneyAssetReport / KenneyModelPostprocessor: import & report on art assets"
                },
                {
                  "done": false,
                  "text": "SpawnVerify / MaterialRepair / FacingProbe / GfxProbe / KenneyBoundsDump: smoke-test/diagnostic checks after build"
                },
                {
                  "done": false,
                  "text": "SceneShot: screenshot capture for build.sh look"
                }
              ]
            },
            "h": 200,
            "id": "widget-1790266219625-2",
            "title": "Quality Task List",
            "type": "checklist",
            "w": 350,
            "x": 90,
            "y": 90
          }
        ]
      },
      "id": "build-editor-tooling",
      "name": "Build & Editor Tooling",
      "type": "custom"
    },
    {
      "canvas": {
        "widgets": [
          {
            "data": {
              "text": "Single JSON save file at Application.persistentDataPath/petshop_save.json, written/read by Core/SaveSystem.cs. Holds the entire persisted game state: balance, reputation, day, staff, price multiplier, shelf/warehouse stock, and every placed furniture item with its shelf stock or pen residents (pets). Versioned (SaveData.Version) - saves older than the current version are discarded rather than migrated."
            },
            "h": 180,
            "id": "widget-1790266201279-0",
            "title": "Intent & Scope Description",
            "type": "text",
            "w": 350,
            "x": 30,
            "y": 30
          },
          {
            "data": {
              "techs": [
                "JsonUtility (Unity built-in JSON)",
                "Local filesystem (Application.persistentDataPath)"
              ]
            },
            "h": 200,
            "id": "widget-1790266219578-1",
            "title": "Tech Stack Profiles",
            "type": "techstack",
            "w": 350,
            "x": 60,
            "y": 60
          },
          {
            "data": {
              "fields": [
                {
                  "flags": "-",
                  "name": "Version",
                  "notes": "Save format version; saves below current version are discarded, not migrated",
                  "type": "int"
                },
                {
                  "flags": "-",
                  "name": "Balance",
                  "notes": "-",
                  "type": "float"
                },
                {
                  "flags": "-",
                  "name": "Reputation",
                  "notes": "-",
                  "type": "float"
                },
                {
                  "flags": "-",
                  "name": "Day",
                  "notes": "-",
                  "type": "int"
                },
                {
                  "flags": "-",
                  "name": "Staff",
                  "notes": "-",
                  "type": "int"
                },
                {
                  "flags": "-",
                  "name": "PriceMultiplier",
                  "notes": "-",
                  "type": "float"
                },
                {
                  "flags": "-",
                  "name": "SavedAt",
                  "notes": "ISO-8601 UTC timestamp",
                  "type": "string"
                },
                {
                  "flags": "-",
                  "name": "Stock",
                  "notes": "id + qty pairs, shelf stock",
                  "type": "StockEntry[]"
                },
                {
                  "flags": "-",
                  "name": "Warehouse",
                  "notes": "delivered units still in the stockroom, keyed by category",
                  "type": "StockEntry[]"
                },
                {
                  "flags": "-",
                  "name": "PlacedObjects",
                  "notes": "catalogId, cellX/cellY, variant, rotation, shelfStock[], pets[] (PetSaveData)",
                  "type": "PlacedItem[]"
                }
              ]
            },
            "h": 240,
            "id": "widget-1790266219613-2",
            "title": "Database Table Schema",
            "type": "schema",
            "w": 440,
            "x": 90,
            "y": 90
          }
        ]
      },
      "id": "local-save-file",
      "name": "Local Save File",
      "type": "storage"
    }
  ],
  "connections": [
    {
      "from": "build-editor-tooling",
      "protocol": "Unity Editor build pipeline (headless build.sh)",
      "to": "pet-shop-simulator-game-client"
    },
    {
      "from": "pet-shop-simulator-game-client",
      "protocol": "Local filesystem I/O (JsonUtility JSON)",
      "to": "local-save-file"
    }
  ],
