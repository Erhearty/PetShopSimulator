{
  "version": 2,
  "checks": [
    {
      "id": "playmode",
      "name": "PlayMode tests",
      "kind": "test",
      "command": "./build.sh playmode",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "playtest",
      "name": "Full playtest (build + spawnverify, playmode, smoke, soak)",
      "kind": "external",
      "command": "./build.sh linux && ./build.sh playtest",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "unity-smoke",
      "name": "Unity scene build + headless smoke",
      "kind": "external",
      "command": "./build.sh assets && ./build.sh scene && ./build.sh linux && ./build.sh smoke",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "shell-syntax",
      "name": "Shell script syntax",
      "kind": "lint",
      "command": "bash -n build.sh && bash -n Tools/purge_history.sh",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "test",
      "name": "EditMode tests",
      "kind": "test",
      "command": "pre=\"$(git diff --name-only)\"; ./build.sh test; rc=$?; git diff --name-only | while IFS= read -r f; do printf '%s\\n' \"$pre\" | grep -qxF -- \"$f\" || git checkout -- \"$f\"; done; [ \"$rc\" -eq 0 ] && true",
      "enabled": true,
      "scope": "repo"
    }
  ]
}
